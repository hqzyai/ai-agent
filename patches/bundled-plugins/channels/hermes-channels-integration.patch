+@app.post("/api/messaging/im/{platform_id}/onboarding/start")
+async def start_im_onboarding(platform_id: str, body: MessagingImOnboardingStart):
+    platform = platform_id.strip().lower()
+    if platform not in _IM_ONBOARDING_PLATFORMS:
+        raise HTTPException(status_code=404, detail=f"QR onboarding is not available for {platform_id}.")
+
+    effective_profile = body.profile
+    conflict = _multiplex_port_binding_conflict(platform, effective_profile)
+    if conflict:
+        raise HTTPException(status_code=409, detail=conflict)
+
+    pairing_id = secrets.token_urlsafe(16)
+    try:
+        record = await asyncio.to_thread(_start_im_onboarding_record, platform, effective_profile)
+    except HTTPException:
+        raise
+    except Exception as exc:
+        _log.exception("Failed to start %s onboarding", platform)
+        raise HTTPException(status_code=500, detail=str(exc)) from exc
+
+    with _im_onboarding_lock:
+        _prune_im_onboarding_sessions()
+        _supersede_im_onboarding_sessions(platform, effective_profile)
+        _im_onboarding_sessions[pairing_id] = record
+
+    threading.Thread(target=_run_im_onboarding, args=(pairing_id, platform), daemon=True).start()
+    return _im_onboarding_payload(pairing_id, record)
