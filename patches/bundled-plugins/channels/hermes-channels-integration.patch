+@app.post("/api/messaging/im/{platform_id}/onboarding/{pairing_id}/apply")
+async def apply_im_onboarding(platform_id: str, pairing_id: str, body: MessagingImOnboardingApply):
+    platform = platform_id.strip().lower()
+    if platform not in _IM_ONBOARDING_PLATFORMS:
+        raise HTTPException(status_code=404, detail=f"QR onboarding is not available for {platform_id}.")
+    with _im_onboarding_lock:
+        _prune_im_onboarding_sessions()
+        record = _im_onboarding_sessions.get(pairing_id)
+        if not record or record.platform != platform:
+            raise HTTPException(status_code=404, detail="Setup session was not found. Start a new setup.")
+        if record.status != "connected" or not record.credentials:
+            raise HTTPException(status_code=409, detail="Setup is not connected yet.")
+        credentials = dict(record.credentials)
+        effective_profile = body.profile or record.profile
+
+    try:
+        result = await asyncio.to_thread(_save_im_onboarding_credentials, platform, credentials, effective_profile)
+    except HTTPException:
+        raise
+    except Exception as exc:
+        _log.exception("Failed to save %s onboarding", platform)
+        raise HTTPException(status_code=500, detail=f"Failed to save {platform} setup.") from exc
+
+    with _im_onboarding_lock:
+        _im_onboarding_sessions.pop(pairing_id, None)
+    return result
+
