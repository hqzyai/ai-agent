+@app.delete("/api/messaging/im/{platform_id}/onboarding/{pairing_id}")
+async def cancel_im_onboarding(platform_id: str, pairing_id: str):
+    platform = platform_id.strip().lower()
+    if platform not in _IM_ONBOARDING_PLATFORMS:
+        raise HTTPException(status_code=404, detail=f"QR onboarding is not available for {platform_id}.")
+    with _im_onboarding_lock:
+        record = _im_onboarding_sessions.pop(pairing_id, None)
+        if record and record.platform == platform:
+            record.status = "cancelled"
+    return {"ok": True}
