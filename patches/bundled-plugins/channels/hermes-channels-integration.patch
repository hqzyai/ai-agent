+_IM_ONBOARDING_PLATFORMS = frozenset({"dingtalk", "weixin", "qqbot"})
+_IM_ONBOARDING_TTL_SECONDS = 600
+_IM_ONBOARDING_TERMINAL_STATUSES = {"connected", "error", "expired", "cancelled"}
+
+
+@dataclass
+class _MessagingImOnboardingSession:
+    platform: str
+    expires_at: str
+    expires_at_ts: float
+    profile: str | None = None
+    status: str = "starting"
+    qr_payload: str | None = None
+    qr_data_url: str | None = None
+    credentials: dict[str, str] | None = None
+    error: str | None = None
+    device_code: str | None = None
+    interval: int = 2
+    qrcode_value: str | None = None
+    current_base_url: str | None = None
+    aes_key: str | None = None
+    refresh_count: int = 0
+
+
+_im_onboarding_sessions: dict[str, _MessagingImOnboardingSession] = {}
+_im_onboarding_lock = threading.RLock()
+
+
+def _qr_data_url(payload: str | None) -> str | None:
+    raw = str(payload or "").strip()
+    if not raw:
+        return None
+    try:
+        import qrcode
+        import qrcode.image.svg
+
+        qr = qrcode.QRCode(image_factory=qrcode.image.svg.SvgPathImage, border=2)
+        qr.add_data(raw)
+        qr.make(fit=True)
+        svg = qr.make_image().to_string()
+        return "data:image/svg+xml;base64," + base64.b64encode(svg).decode("ascii")
+    except Exception:
+        _log.debug("failed to render onboarding QR", exc_info=True)
+        return None
+
+
+def _im_onboarding_payload(pairing_id: str, record: _MessagingImOnboardingSession) -> dict[str, Any]:
+    credentials = record.credentials or {}
+    return {
+        "pairing_id": pairing_id,
+        "platform": record.platform,
+        "status": record.status,
+        "qr_payload": record.qr_payload,
+        "qr_data_url": record.qr_data_url,
+        "expires_at": record.expires_at,
+        "error": record.error,
+        "account_id": credentials.get("account_id") or credentials.get("app_id"),
+        "user_id": credentials.get("user_id") or credentials.get("user_openid"),
+    }
+
+
+def _prune_im_onboarding_sessions() -> None:
+    now = time.time()
+    remove_ids: list[str] = []
+    for pairing_id, record in _im_onboarding_sessions.items():
+        if record.expires_at_ts <= now and record.status not in _IM_ONBOARDING_TERMINAL_STATUSES:
+            record.status = "expired"
+            record.error = "QR setup expired. Start a new setup."
+        if record.status in _IM_ONBOARDING_TERMINAL_STATUSES and record.expires_at_ts + 300 <= now:
+            remove_ids.append(pairing_id)
+    for pairing_id in remove_ids:
+        _im_onboarding_sessions.pop(pairing_id, None)
+
+
+def _supersede_im_onboarding_sessions(platform: str, profile: str | None) -> None:
+    for existing in _im_onboarding_sessions.values():
+        if (
+            existing.platform == platform
+            and (existing.profile or "") == (profile or "")
+            and existing.status not in _IM_ONBOARDING_TERMINAL_STATUSES
+        ):
+            existing.status = "cancelled"
+            existing.error = "Superseded by a newer setup session."
+
+
+def _set_im_record(pairing_id: str, **patch: Any) -> _MessagingImOnboardingSession | None:
+    with _im_onboarding_lock:
+        record = _im_onboarding_sessions.get(pairing_id)
+        if not record:
+            return None
+        for key, value in patch.items():
+            setattr(record, key, value)
+        return record
+
+
+def _run_dingtalk_onboarding(pairing_id: str) -> None:
+    try:
+        from hermes_cli.dingtalk_auth import wait_for_registration_success
+
+        with _im_onboarding_lock:
+            record = _im_onboarding_sessions.get(pairing_id)
+            if not record or not record.device_code:
+                return
+            device_code = record.device_code
+            interval = record.interval
+            expires_in = max(1, int(record.expires_at_ts - time.time()))
+            record.status = "waiting"
+
+        client_id, client_secret = wait_for_registration_success(
+            device_code,
+            interval=interval,
+            expires_in=expires_in,
+        )
+        _set_im_record(
+            pairing_id,
+            status="connected",
+            credentials={"client_id": client_id, "client_secret": client_secret},
+            error=None,
+        )
+    except Exception as exc:
+        _set_im_record(pairing_id, status="error", error=str(exc))
+
+
+async def _weixin_refresh_qr() -> tuple[str, str]:
+    from gateway.platforms.weixin import EP_GET_BOT_QR, ILINK_BASE_URL, QR_TIMEOUT_MS, _api_get, _make_ssl_connector
+    import aiohttp
+
+    async with aiohttp.ClientSession(trust_env=True, connector=_make_ssl_connector()) as session:
+        qr_resp = await _api_get(
+            session,
+            base_url=ILINK_BASE_URL,
+            endpoint=f"{EP_GET_BOT_QR}?bot_type=3",
+            timeout_ms=QR_TIMEOUT_MS,
+        )
+    qrcode_value = str(qr_resp.get("qrcode") or "").strip()
+    qrcode_url = str(qr_resp.get("qrcode_img_content") or "").strip()
+    if not qrcode_value:
+        raise RuntimeError("Weixin QR response missing qrcode")
+    return qrcode_value, qrcode_url or qrcode_value
+
+
+async def _weixin_poll_once(record: _MessagingImOnboardingSession) -> dict[str, Any]:
+    from gateway.platforms.weixin import EP_GET_QR_STATUS, QR_TIMEOUT_MS, _api_get, _make_ssl_connector
+    import aiohttp
+
+    async with aiohttp.ClientSession(trust_env=True, connector=_make_ssl_connector()) as session:
+        return await _api_get(
+            session,
+            base_url=record.current_base_url or "https://ilinkai.weixin.qq.com",
+            endpoint=f"{EP_GET_QR_STATUS}?qrcode={record.qrcode_value}",
+            timeout_ms=QR_TIMEOUT_MS,
+        )
+
+
+def _run_weixin_onboarding(pairing_id: str) -> None:
+    while True:
+        with _im_onboarding_lock:
+            record = _im_onboarding_sessions.get(pairing_id)
+            if not record or record.status in _IM_ONBOARDING_TERMINAL_STATUSES:
+                return
+            if record.expires_at_ts <= time.time():
+                record.status = "expired"
+                record.error = "Weixin QR setup expired. Start a new setup."
+                return
+
+        try:
+            status_resp = asyncio.run(_weixin_poll_once(record))
+        except Exception:
+            time.sleep(1)
+            continue
+
+        status = str(status_resp.get("status") or "wait")
+        if status == "wait":
+            _set_im_record(pairing_id, status="waiting")
+        elif status == "scaned":
+            _set_im_record(pairing_id, status="scanned")
+        elif status == "scaned_but_redirect":
+            redirect_host = str(status_resp.get("redirect_host") or "").strip()
+            if redirect_host:
+                _set_im_record(pairing_id, current_base_url=f"https://{redirect_host}")
+        elif status == "expired":
+            with _im_onboarding_lock:
+                record = _im_onboarding_sessions.get(pairing_id)
+                if not record:
+                    return
+                record.refresh_count += 1
+                if record.refresh_count > 3:
+                    record.status = "expired"
+                    record.error = "Weixin QR code expired too many times. Start a new setup."
+                    return
+            try:
+                qrcode_value, qr_payload = asyncio.run(_weixin_refresh_qr())
+                _set_im_record(
+                    pairing_id,
+                    status="waiting",
+                    qrcode_value=qrcode_value,
+                    qr_payload=qr_payload,
+                    qr_data_url=_qr_data_url(qr_payload),
+                )
+            except Exception as exc:
+                _set_im_record(pairing_id, status="error", error=str(exc))
+                return
+        elif status == "confirmed":
+            account_id = str(status_resp.get("ilink_bot_id") or "").strip()
+            token = str(status_resp.get("bot_token") or "").strip()
+            base_url = str(status_resp.get("baseurl") or "").strip()
+            user_id = str(status_resp.get("ilink_user_id") or "").strip()
+            if not account_id or not token:
+                _set_im_record(pairing_id, status="error", error="Weixin confirmed but credentials were incomplete.")
+                return
+            _set_im_record(
+                pairing_id,
+                status="connected",
+                credentials={
+                    "account_id": account_id,
+                    "token": token,
+                    "base_url": base_url,
+                    "user_id": user_id,
+                },
+                error=None,
+            )
+            return
+        time.sleep(1)
+
+
+def _run_qqbot_onboarding(pairing_id: str) -> None:
+    try:
+        from gateway.platforms.qqbot.constants import ONBOARD_POLL_INTERVAL
+        from gateway.platforms.qqbot.crypto import decrypt_secret
+        from gateway.platforms.qqbot.onboard import BindStatus, _poll_bind_result
+
+        while True:
+            with _im_onboarding_lock:
+                record = _im_onboarding_sessions.get(pairing_id)
+                if not record or record.status in _IM_ONBOARDING_TERMINAL_STATUSES:
+                    return
+                if record.expires_at_ts <= time.time():
+                    record.status = "expired"
+                    record.error = "QQ QR setup expired. Start a new setup."
+                    return
+                task_id = record.device_code or ""
+                aes_key = record.aes_key or ""
+                record.status = "waiting"
+
+            status, app_id, encrypted_secret, user_openid = _poll_bind_result(task_id)
+            if status == BindStatus.COMPLETED:
+                _set_im_record(
+                    pairing_id,
+                    status="connected",
+                    credentials={
+                        "app_id": app_id,
+                        "client_secret": decrypt_secret(encrypted_secret, aes_key),
+                        "user_openid": user_openid,
+                    },
+                    error=None,
+                )
+                return
+            if status == BindStatus.EXPIRED:
+                _set_im_record(pairing_id, status="expired", error="QQ QR code expired. Start a new setup.")
+                return
+            time.sleep(ONBOARD_POLL_INTERVAL)
+    except Exception as exc:
+        _set_im_record(pairing_id, status="error", error=str(exc))
+
+
+def _start_im_onboarding_record(platform: str, profile: str | None) -> _MessagingImOnboardingSession:
+    expires_at_ts = time.time() + _IM_ONBOARDING_TTL_SECONDS
+    expires_at = _utc_iso_from_ts(expires_at_ts)
+
+    if platform == "dingtalk":
+        from hermes_cli.dingtalk_auth import begin_registration
+
+        reg = begin_registration()
+        qr_payload = str(reg["verification_uri_complete"])
+        return _MessagingImOnboardingSession(
+            platform=platform,
+            profile=profile,
+            status="waiting",
+            qr_payload=qr_payload,
+            qr_data_url=_qr_data_url(qr_payload),
+            expires_at=expires_at,
+            expires_at_ts=min(expires_at_ts, time.time() + int(reg.get("expires_in", _IM_ONBOARDING_TTL_SECONDS))),
+            device_code=str(reg["device_code"]),
+            interval=int(reg.get("interval", 3)),
+        )
+
+    if platform == "weixin":
+        from gateway.platforms.weixin import ILINK_BASE_URL, check_weixin_requirements
+
+        if not check_weixin_requirements():
+            raise RuntimeError("Weixin setup needs aiohttp and cryptography.")
+        qrcode_value, qr_payload = asyncio.run(_weixin_refresh_qr())
+        return _MessagingImOnboardingSession(
+            platform=platform,
+            profile=profile,
+            status="waiting",
+            qr_payload=qr_payload,
+            qr_data_url=_qr_data_url(qr_payload),
+            expires_at=expires_at,
+            expires_at_ts=expires_at_ts,
+            qrcode_value=qrcode_value,
+            current_base_url=ILINK_BASE_URL,
+        )
+
+    if platform == "qqbot":
+        from gateway.platforms.qqbot.onboard import _create_bind_task, build_connect_url
+
+        task_id, aes_key = _create_bind_task()
+        qr_payload = build_connect_url(task_id)
+        return _MessagingImOnboardingSession(
+            platform=platform,
+            profile=profile,
+            status="waiting",
+            qr_payload=qr_payload,
+            qr_data_url=_qr_data_url(qr_payload),
+            expires_at=expires_at,
+            expires_at_ts=expires_at_ts,
+            device_code=task_id,
+            aes_key=aes_key,
+        )
+
+    raise ValueError(f"Unsupported IM onboarding platform: {platform}")
+
+
+def _run_im_onboarding(pairing_id: str, platform: str) -> None:
+    if platform == "dingtalk":
+        _run_dingtalk_onboarding(pairing_id)
+    elif platform == "weixin":
+        _run_weixin_onboarding(pairing_id)
+    elif platform == "qqbot":
+        _run_qqbot_onboarding(pairing_id)
+
+
+def _save_im_onboarding_credentials(platform: str, credentials: dict[str, str], profile: str | None) -> dict[str, Any]:
+    with _config_profile_scope(profile):
+        if platform == "dingtalk":
+            save_env_value("DINGTALK_CLIENT_ID", credentials.get("client_id", ""))
+            save_env_value("DINGTALK_CLIENT_SECRET", credentials.get("client_secret", ""))
+        elif platform == "weixin":
+            from gateway.platforms.weixin import ILINK_BASE_URL, save_weixin_account
+
+            account_id = credentials.get("account_id", "")
+            token = credentials.get("token", "")
+            base_url = credentials.get("base_url") or ILINK_BASE_URL
+            user_id = credentials.get("user_id", "")
+            save_weixin_account(
+                str(get_hermes_home()),
+                account_id=account_id,
+                token=token,
+                base_url=base_url,
+                user_id=user_id,
+            )
+            save_env_value("WEIXIN_ACCOUNT_ID", account_id)
+            save_env_value("WEIXIN_TOKEN", token)
+            save_env_value("WEIXIN_BASE_URL", base_url)
+            save_env_value(
+                "WEIXIN_CDN_BASE_URL",
+                os.getenv("WEIXIN_CDN_BASE_URL", "") or "https://novac2c.cdn.weixin.qq.com/c2c",
+            )
+            if user_id:
+                save_env_value("WEIXIN_DM_POLICY", "allowlist")
+                save_env_value("WEIXIN_ALLOW_ALL_USERS", "false")
+                save_env_value("WEIXIN_ALLOWED_USERS", user_id)
+            else:
+                save_env_value("WEIXIN_DM_POLICY", "pairing")
+                save_env_value("WEIXIN_ALLOW_ALL_USERS", "false")
+        elif platform == "qqbot":
+            save_env_value("QQ_APP_ID", credentials.get("app_id", ""))
+            save_env_value("QQ_CLIENT_SECRET", credentials.get("client_secret", ""))
+            save_env_value("QQ_ALLOW_ALL_USERS", "false")
+            user_openid = credentials.get("user_openid", "")
+            if user_openid:
+                save_env_value("QQ_ALLOWED_USERS", user_openid)
+        else:
+            raise ValueError(f"Unsupported IM onboarding platform: {platform}")
+
+        _write_platform_enabled(platform, True)
+
+    restart_result = _restart_gateway_after_whatsapp_onboarding(profile)
+    return {
+        "ok": True,
+        "platform": platform,
+        "needs_restart": not restart_result["restart_started"],
+        **restart_result,
+    }
